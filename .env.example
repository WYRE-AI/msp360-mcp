# Single-tenant credentials (stdio, and HTTP only when AUTH_MODE=env).
# The gateway-mode Compose service does not load these. Do not add them to
# that service's environment or via env_file.
MSP360_USERNAME=
MSP360_PASSWORD=

# stdio (default) or http
# MCP_TRANSPORT=stdio

# Bind address. When MCP_HTTP_HOST is unset, the HTTP server binds 127.0.0.1.
# A configured CONDUIT_S2S_SECRET honors this value. The container image sets
# 0.0.0.0. Without a secret, MCP_ALLOW_INSECURE_DEV=1 forces 127.0.0.1.
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=8080

# Required to start the HTTP transport. The process logs an error and exits
# non-zero when this is empty or a known placeholder (changeme, placeholder,
# your-s2s-secret, secret, password, test, and unresolved ${...} templates).
# Value is the gateway-provisioned service-to-service secret. Never commit a
# real secret. Leave this empty.
CONDUIT_S2S_SECRET=

# Local development only. Set to exactly 1 to start HTTP without CONDUIT_S2S_SECRET.
# The server logs a warning, does not check X-Gateway-S2S, and binds 127.0.0.1
# even if MCP_HTTP_HOST is a wider address. A placeholder secret is still refused.
# MCP_ALLOW_INSECURE_DEV=1

# env (default) or gateway. The gateway Compose service hardcodes gateway and
# sets no static MSP360_USERNAME or MSP360_PASSWORD.
# AUTH_MODE=env

# LOG_LEVEL=info
